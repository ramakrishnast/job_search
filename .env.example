# JobPilot configuration. Copy to .env, fill in, then: docker compose up -d --build
# .env is gitignored — never commit it.

# --- Server (Docker) ---
# Host port the app is served on: http://localhost:<PORT>
PORT=8000
# 127.0.0.1 = only this machine. 0.0.0.0 = reachable from your network (no login! use a VPN/firewall).
BIND_ADDRESS=127.0.0.1

# --- LLM (needed for fit scoring, tailoring, STAR stories and mock interviews) ---
# Set ONE key. With OPENAI_API_KEY set, OpenAI is used automatically.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=auto            # auto | openai | anthropic
# OPENAI_BASE_URL=             # optional: Azure OpenAI / OpenAI-compatible gateway

# Models — leave empty for defaults (OpenAI: gpt-5-mini for JD parsing, gpt-5 for everything else).
LLM_MODEL_PARSE=
LLM_MODEL_DEFAULT=
# LLM_MODEL_INTERVIEW=
# If you pick a model that isn't in the built-in price table, set its price so the budget guard is accurate:
# LLM_PRICE_INPUT_PER_MTOK=
# LLM_PRICE_OUTPUT_PER_MTOK=

# Max spend per rolling 24h for BACKGROUND work (auto-scoring after discovery). Actions you click are not capped.
LLM_DAILY_BUDGET_USD=5

# --- Discovery schedule ---
DISCOVERY_SCHEDULE_ENABLED=true
DISCOVERY_HOUR=6
DISCOVERY_MINUTE=43
TIMEZONE=America/New_York
# Auto-score at most this many new matching jobs per run (cost guard). AUTO_SCORE_NEW=false disables it.
MAX_AUTO_SCORES_PER_RUN=25
AUTO_SCORE_NEW=true
# Seconds between requests to the same ATS host (robots.txt Crawl-delay wins if larger).
HTTP_MIN_INTERVAL_SECONDS=1.0

LOG_LEVEL=INFO
