# JobPilot configuration. Copy to .env and fill in. .env is gitignored.

# --- Claude API (required for LLM scoring, tailoring, story generation and interviews) ---
ANTHROPIC_API_KEY=
# Models (any Claude model id). Parsing runs on every new job, so it uses the cheapest model.
LLM_MODEL_PARSE=claude-haiku-5-5
LLM_MODEL_DEFAULT=claude-sonnet-5-5
# LLM_MODEL_INTERVIEW=claude-sonnet-5-5
# Max spend per rolling 24h for BACKGROUND work (auto-scoring after discovery). Interactive actions are not capped.
LLM_DAILY_BUDGET_USD=5
# Server-side refusal fallback on Sonnet/Opus 5.5 (Claude API only). Set false on Bedrock/Vertex proxies.
LLM_REFUSAL_FALLBACK=true

# --- Discovery schedule ---
DISCOVERY_SCHEDULE_ENABLED=true
DISCOVERY_HOUR=6
DISCOVERY_MINUTE=43
TIMEZONE=America/New_York
# Score at most this many new matching jobs automatically per run (cost guard). 0 disables auto-scoring.
MAX_AUTO_SCORES_PER_RUN=25
AUTO_SCORE_NEW=true
# Seconds between requests to the same ATS host (robots.txt Crawl-delay wins if larger).
HTTP_MIN_INTERVAL_SECONDS=1.0

# --- Server ---
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# DATA_DIR=./data
